	tree test = [&R] ((((Physarum_album_MA83355:0.02,Physarum_viride_MA80112:0.03)98:0.05,(Badhamia_utricularis_MA65001:0.04,Badhamia_panicea_MA71234:0.05)87:0.03)72:0.02,((Didymium_squamulosum_MA58962:0.03,Didymium_melanospermum_MA44011:0.02)95:0.04,Diderma_effusum_MA80673:0.06)64:0.02)100:0.05,Lycogala_epidendrum_MA30122:0.12);
