	Physarum_viride_MA80112
	Badhamia_utricularis_MA65001
	Badhamia_panicea_MA71234
	Didymium_squamulosum_MA58962
	Didymium_melanospermum_MA44011
	Diderma_effusum_MA80673
	Lycogala_epidendrum_MA30122
	;
end;

